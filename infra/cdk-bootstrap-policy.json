{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BootstrapIAMRoleManagement",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:GetRolePolicyVersion",
        "iam:ListRolePolicies",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:PassRole",
        "iam:CreatePolicy",
        "iam:DeletePolicy"
      ],
      "Resource": ["arn:aws:iam::214745598862:role/cdk-hnb659fds-*", "arn:aws:iam::214745598862:policy/cdk-hnb659fds-*"]
    },
    {
      "Sid": "SSMParametersForBootstrap",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:GetParameter", "ssm:DescribeParameters", "ssm:GetParametersByPath"],
      "Resource": [
        "arn:aws:ssm:*:214745598862:parameter/cdk-bootstrap/*",
        "arn:aws:ssm:*:214745598862:parameter/cdk-hnb659fds/*"
      ]
    },
    {
      "Sid": "ECRForContainerAssets",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": ["arn:aws:ecr:*:214745598862:repository/cdk-hnb659fds-container-assets-*"]
    },
    {
      "Sid": "ECRGetAuthToken",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": ["*"]
    },
    {
      "Sid": "S3StagingBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:DeleteBucket",
        "s3:DeleteObject",
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-hnb659fds-stagingbucket-214745598862-*",
        "arn:aws:s3:::cdk-hnb659fds-stagingbucket-214745598862-*/*"
      ]
    },
    {
      "Sid": "CloudFormationStackOps",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:DeleteStack",
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:ListStacks"
      ],
      "Resource": [
        "arn:aws:cloudformation:*:214745598862:stack/CDKToolkit/*",
        "arn:aws:cloudformation:*:214745598862:stack/cdk-*/*"
      ]
    },
    {
      "Sid": "AssumeRolesCreatedByCDK",
      "Effect": "Allow",
      "Action": ["sts:AssumeRole"],
      "Resource": ["arn:aws:iam::214745598862:role/cdk-hnb659fds-*"]
    }
  ]
}
